{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seculens.dev/schemas/waivers-1.0.schema.json",
  "title": "SecuLens waiver file 1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "\\S",
            "description": "Finding ruleId or one of its aliases"
          },
          "subject": {
            "type": "string",
            "pattern": "\\S",
            "description": "Exact finding subject; omit to match every subject"
          },
          "justification": {
            "type": "string",
            "pattern": "\\S"
          },
          "approvedBy": {
            "type": "string",
            "pattern": "\\S"
          },
          "expires": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date",
            "description": "Last day the waiver applies (inclusive, UTC)"
          }
        },
        "required": [
          "ruleId",
          "justification",
          "approvedBy",
          "expires"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "waivers"
  ],
  "additionalProperties": false
}
